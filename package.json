{
  "name": "n8n-nodes-openapi-compatible",
  "version": "0.1.6",
  "description": "An OpenAPI compatible node package for n8n.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kphillipsjr1101/n8n-nodes-openapi-compatible",
  "author": {
    "name": "Kevin Phillips",
    "email": "k.phillips.jr1101@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kphillipsjr1101/n8n-nodes-openapi-compatible.git"
  },
  "engines": {
    "node": ">=20.15",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "uuid@<11.1.1": ">=11.1.1"
    }
  },
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "test": "pnpm vitest --run",
    "test:watch": "pnpm vitest --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OpenApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OpenAPINode/OpenApiNode.node.js"
    ]
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.13.10",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^5.0.1",
    "n8n-workflow": "^2.8.0",
    "prettier": "^3.3.2",
    "semantic-release": "^25.0.3",
    "typescript": "^5.5.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
